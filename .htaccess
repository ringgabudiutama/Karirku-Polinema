# Bila seluruh folder proyek ada di htdocs XAMPP, hanya public/ yang boleh dibuka lewat URL.
# backend/, frontend/views/, storage/ (KTM, ijazah), database/, tests/, dan berkas di root ditolak.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # http://localhost/karirku-polinema/ -> langsung ke aplikasi
  RewriteRule ^$ public/ [R=302,L]
  # Apa pun di luar public/ ditolak (403)
  RewriteRule !^public(/|$) - [F,L]
</IfModule>
