# Tanpa daftar isi folder, dan berkas tersembunyi (.git, .env, .htaccess) tidak bisa diunduh.
Options -Indexes

# Manifest aplikasi (Tambahkan ke layar utama di HP)
AddType application/manifest+json .webmanifest
<FilesMatch "^\.(?!well-known)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Arahkan semua request yang bukan file/folder asli ke index.php,
# lalu path aslinya dikirim lewat query string "url" (dibaca Router.php).
RewriteEngine On

# Kalau ada yang tanpa sengaja membuka .html lama, arahkan ke rute PHP
# baru supaya link lama (kalau sempat dibagikan) tidak 404 begitu saja.
RewriteRule ^index\.html$ index.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
