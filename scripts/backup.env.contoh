# Salin menjadi /etc/karirku/backup.env (atau scripts/backup.env), lalu ubah.
# JANGAN menulis password database di sini: pakai ~/.pgpass (chmod 600) atau akun OS postgres.
BACKUP_DIR=/var/backups/karirku
PGDATABASE=karirku_polinema
# PGHOST=127.0.0.1
# PGUSER=karirku_backup
UPLOAD_DIR=/opt/karirku/storage/uploads
KEEP_HARIAN=14
KEEP_MINGGUAN=8
KEEP_BULANAN=24        # 60 = simpan 5 tahun
# BACKUP_GPG_PENERIMA=admin@contoh.ac.id    # enkripsi hasil backup (sangat disarankan)
